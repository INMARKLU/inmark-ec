Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Redirigir /index.html a /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# Redirigir URLs con .html a sin .html (excepto index)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(.+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Servir el archivo .html cuando se pide sin extensión
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)$ $1.html [L]
